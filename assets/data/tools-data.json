/* ==========================================================
   scripts/build-sitemap.js

   Single sitemap build script for the project. Driven entirely by
   assets/tools-data.json — the same source of truth used by the
   homepage — so it stays correct and scalable as tools are added,
   with no per-tool manual list to maintain (works fine past 1000+
   tools since it's just iterating the JSON, not scanning the disk
   for pages).

   Run after editing tools-data.json (or as a prebuild step):

     node scripts/build-sitemap.js

   It does two things:

   1. Regenerates the category tool-lists inside sitemap.html.
      Only the <div class="footer-col"> blocks whose heading matches
      a category name in tools-data.json are touched — everything
      else in sitemap.html (Main Pages, Blog Articles, layout, etc.)
      is left exactly as-is. [Preserved from the original script.]

   2. Generates/refreshes sitemap.xml (the machine-readable XML
      sitemap for search engines) with:
        - the homepage
        - a short fixed list of static/legal/category-hub pages
        - every tool in tools-data.json, as a clean canonical URL

   No dependencies, no Python, no additional runtime — plain Node.js.
========================================================== */

'use strict';

const fs = require('fs');
const path = require('path');

const PROJECT_ROOT = path.resolve(__dirname, '..');
const SITE_ROOT = 'https://tickmarktools.com';

const dataPath = path.join(PROJECT_ROOT, 'assets', 'tools-data.json');
const sitemapHtmlPath = path.join(PROJECT_ROOT, 'sitemap.html');
const sitemapXmlPath = path.join(PROJECT_ROOT, 'sitemap.xml');

// ---------------------------------------------------------------------------
// Static pages that aren't tools and so don't live in tools-data.json, but
// still need to be in sitemap.xml. Category hub pages (Calculators, PDF
// Tools, etc.) are NOT listed here — those are derived automatically from
// each category's "page" field in tools-data.json below, so a category only
// shows up in the sitemap once it actually has its own dedicated page (some
// categories, like Finance and Productivity, just anchor into the homepage
// via "index.html#categories" and correctly get no separate sitemap entry).
// This list only grows when a genuinely new *type* of page is added to the
// site (not when a tool or category is added).
// ---------------------------------------------------------------------------
const STATIC_PAGES = [
  { file: 'about.html', priority: '0.6', changefreq: 'monthly' },
  { file: 'contact.html', priority: '0.5', changefreq: 'monthly' },
  { file: 'blog.html', priority: '0.6', changefreq: 'weekly' },
  { file: 'privacy-policy.html', priority: '0.3', changefreq: 'yearly' },
  { file: 'terms-of-service.html', priority: '0.3', changefreq: 'yearly' },
  { file: 'disclaimer.html', priority: '0.3', changefreq: 'yearly' },
  { file: 'best-pdf-tools.html', priority: '0.5', changefreq: 'monthly' },
  { file: 'best-ai-tools.html', priority: '0.5', changefreq: 'monthly' },
  { file: 'best-calculators.html', priority: '0.5', changefreq: 'monthly' },
  { file: 'how-to-use-tools.html', priority: '0.5', changefreq: 'monthly' },
  { file: 'productivity-tips.html', priority: '0.5', changefreq: 'monthly' },
];

// ---------------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------------

function escapeRegExp(str) {
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function escapeXml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
}

function loadToolsData() {
  if (!fs.existsSync(dataPath)) {
    throw new Error(`Could not find ${path.relative(PROJECT_ROOT, dataPath)} — build-sitemap.js requires it as the single source of truth.`);
  }
  return JSON.parse(fs.readFileSync(dataPath, 'utf8'));
}

// ---------------------------------------------------------------------------
// Step 1: regenerate the category tool-lists inside sitemap.html
// (unchanged behavior from the original script)
// ---------------------------------------------------------------------------

function rebuildSitemapHtml(data) {
  if (!fs.existsSync(sitemapHtmlPath)) {
    console.warn(`⚠ ${path.relative(PROJECT_ROOT, sitemapHtmlPath)} not found — skipping HTML sitemap update.`);
    return;
  }

  let html = fs.readFileSync(sitemapHtmlPath, 'utf8');

  const catById = {};
  data.categories.forEach((c) => { catById[c.id] = c.name; });

  const toolsByCategory = {};
  data.tools.forEach((t) => {
    (toolsByCategory[t.category] = toolsByCategory[t.category] || []).push(t);
  });

  let changed = 0;
  Object.keys(toolsByCategory).forEach((catId) => {
    const name = catById[catId];
    if (!name) return;
    const links = toolsByCategory[catId]
      .map((t) => `      <a href="${t.slug}.html">${t.title}</a>`)
      .join('\n');

    const blockRe = new RegExp(
      `(<h5>${escapeRegExp(name)}</h5>\\n)([\\s\\S]*?)(\\n\\s*</div>)`
    );
    if (blockRe.test(html)) {
      html = html.replace(blockRe, `$1${links}$3`);
      changed++;
    } else {
      console.warn(`⚠ Could not find a matching block for category "${name}" in sitemap.html — left untouched.`);
    }
  });

  fs.writeFileSync(sitemapHtmlPath, html);
  console.log(`✔ sitemap.html updated: ${changed} category block(s) regenerated from tools-data.json.`);
}

// ---------------------------------------------------------------------------
// Step 2: generate sitemap.xml
// ---------------------------------------------------------------------------

function buildSitemapXml(data) {
  const today = new Date().toISOString().slice(0, 10);
  const entries = [];

  // Homepage
  entries.push({ loc: `${SITE_ROOT}/`, priority: '1.0', changefreq: 'weekly' });

  // Static / legal / blog pages (fixed, non-category, non-tool pages)
  STATIC_PAGES.forEach(({ file, priority, changefreq }) => {
    const slug = file.replace(/\.html$/, '');
    entries.push({ loc: `${SITE_ROOT}/${slug}`, priority, changefreq });
  });

  // Category hub pages — derived from tools-data.json's "page" field, not
  // hardcoded. Categories that just anchor into the homepage (page value
  // like "index.html#categories") are correctly skipped since the homepage
  // is already in the sitemap; only categories with their own real page
  // (e.g. "pdf-tools.html") get a dedicated entry. New categories therefore
  // need zero changes to this script — just add them to tools-data.json.
  const seenHubs = new Set();
  (data.categories || []).forEach((cat) => {
    const page = cat.page || '';
    if (!page.endsWith('.html') || page.includes('#')) return; // anchors into homepage, skip
    if (seenHubs.has(page)) return;
    seenHubs.add(page);
    const slug = page.replace(/\.html$/, '');
    entries.push({ loc: `${SITE_ROOT}/${slug}`, priority: '0.8', changefreq: 'weekly' });
  });

  // Every tool, driven entirely by tools-data.json — this is what keeps
  // the sitemap scalable to 1000+ tools with zero manual upkeep. Popular
  // and trending tools get a small priority bump since they're genuinely
  // more important pages to crawl/rank.
  (data.tools || []).forEach((t) => {
    let priority = '0.6';
    if (t.popular) priority = '0.7';
    else if (t.trending) priority = '0.65';

    entries.push({
      loc: `${SITE_ROOT}/${t.slug}`,
      priority,
      changefreq: 'monthly',
    });
  });

  const urlBlocks = entries.map(({ loc, priority, changefreq }) => [
    '  <url>',
    `    <loc>${escapeXml(loc)}</loc>`,
    `    <lastmod>${today}</lastmod>`,
    `    <changefreq>${changefreq}</changefreq>`,
    `    <priority>${priority}</priority>`,
    '  </url>',
  ].join('\n'));

  const xml =
    '<?xml version="1.0" encoding="UTF-8"?>\n' +
    '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n' +
    urlBlocks.join('\n') +
    '\n</urlset>\n';

  fs.writeFileSync(sitemapXmlPath, xml, 'utf8');
  console.log(`✔ sitemap.xml written: ${entries.length} URLs (1 homepage + ${STATIC_PAGES.length} static + ${seenHubs.size} category hubs + ${(data.tools || []).length} tools).`);
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

function run() {
  const data = loadToolsData();
  rebuildSitemapHtml(data);
  buildSitemapXml(data);
}

if (require.main === module) {
  run();
}

module.exports = { run, rebuildSitemapHtml, buildSitemapXml };
